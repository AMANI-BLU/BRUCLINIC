{
  "name": "bruclinic",
  "version": "2.0.0",
  "description": "Borana University Clinic Management System",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-offline.js",
    "start": "node scripts/start-offline.js",
    "dev:backend": "npm --prefix backend run dev",
