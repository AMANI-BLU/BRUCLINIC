# Base URL of the BruClinic API, including the /api suffix.
# Local development:
VITE_API_URL=http://localhost:4000/api

# Production: set this in Vercel → Project → Settings → Environment Variables
# (Production and Preview), then redeploy. Vite bakes it in at build time.
# VITE_API_URL=https://bruclinic-api.onrender.com/api
