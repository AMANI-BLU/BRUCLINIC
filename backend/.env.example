# ─────────────────────────────────────────────────────────────────
# BruClinic — Environment Configuration
# ─────────────────────────────────────────────────────────────────
# SETUP: Run "npm run setup" for an interactive wizard, or copy this
# file to ".env" and fill in the values manually.
#
# NEVER commit .env to version control. It contains secrets.
# ─────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────
# development | production
NODE_ENV=development

# Server binding. Use 0.0.0.0 to listen on all interfaces in production.
HOST=localhost
PORT=4000

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────
# PostgreSQL 14+ required.
# Create the database first: CREATE DATABASE bruclinic;
# DB_USER is a PostgreSQL role (not a MySQL account).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=bruclinic

# Max concurrent DB connections in the connection pool (5-30 recommended)
DATABASE_POOL_MAX=10

# ── Security ──────────────────────────────────────────────────────
# JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 characters. Rotate immediately if ever exposed.
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars

# ── Network / CORS ────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Example for production: https://clinic.boru.edu.et
CORS_ORIGIN=http://localhost:5173

# Maximum allowed request body size in bytes (default: 1 MB)
BODY_LIMIT_BYTES=1048576

# Maximum size of an uploaded restore snapshot in bytes (default: 50 MB).
# Restore payloads are administrator-only but can legitimately be large.
BACKUP_MAX_BYTES=52428800

# Initial JWT lifetime in hours. Administrators can change this later in
# Security Center → System Config (session_timeout_hours).
SESSION_TIMEOUT_HOURS=8

# ── Admin Account Seed ────────────────────────────────────────────
# Used by "npm run db:seed" to create the initial administrator.
# Remove or clear these after initial setup for security.
SEED_ADMIN_USERNAME='admin'
SEED_ADMIN_PASSWORD='admin123'
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Clinic Administrator
