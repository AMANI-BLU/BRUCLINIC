{
  "name": "bruclinic-backend",
  "version": "2.0.0",
  "description": "Borana University Clinic Management System — API Server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "setup": "node src/setup.js",
    "setup:force": "node src/setup.js --force",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:check": "node src/db/check.js",
    "db:reset": "node src/db/migrate.js && node src/db/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.23.1"
  }
}
